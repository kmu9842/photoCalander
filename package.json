{
  "name": "photo-calendar",
  "productName": "Photo Calendar",
  "version": "1.3.1",
  "description": "사진과 메모를 담는 Windows 바탕화면 달력 위젯",
  "author": "Photo Calendar",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "vitest run",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:interactions": "node scripts/test-interactions.mjs",
    "test:layout": "node scripts/test-layout.mjs",
    "test:editor-size": "node scripts/test-editor-size.mjs",
    "test:formatting": "node scripts/test-formatting.mjs",
    "test:photos": "node scripts/test-photo-layout.mjs",
    "test:calendar-import": "node scripts/test-calendar-import.mjs",
    "test:rich-text": "node scripts/test-rich-text.mjs",
    "test:background": "node scripts/test-background.mjs",
    "test:package": "node scripts/test-package.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:dir": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "koffi": "^2.15.0",
    "lucide-react": "^0.468.0",
    "node-ical": "^0.27.3",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "local.photocalendar.widget",
    "productName": "Photo Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "PhotoCalendar-${version}-Windows.exe"
    }
  }
}
